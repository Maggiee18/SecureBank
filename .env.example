# Copy to .env and change every value. Never commit .env.

# PostgreSQL
DB_USERNAME=securebank
DB_PASSWORD=change-me-strong-db-password

# JWT signing key: at least 32 characters, random. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_EXPIRATION=PT30M

# Optional: bootstrap an ADMIN user at startup (used to block/unblock accounts and read audit logs)
ADMIN_EMAIL=admin@securebank.local
ADMIN_PASSWORD=change-me-Admin@123

# Set to false to hide Swagger UI and /v3/api-docs
SWAGGER_ENABLED=true

# Browser origins allowed to call the API directly (comma separated). Add your deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
